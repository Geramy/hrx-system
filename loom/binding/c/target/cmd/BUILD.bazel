load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "program_plan",
    srcs = ["program_plan.c"],
    hdrs = ["program_plan.h"],
    linkstatic = True,
    visibility = ["//loom/src/loom/target/arch/cmd/lower:__pkg__"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/command",
        "//loom/src/loom/target/arch/cmd:program",
        "//loom/src/loom/target/arch/cmd/lower:launch_artifact",
        "//loom/src/loom/target/arch/cmd/lower:program_plan",
        "//loom/src/loom/target/arch/cmd/lower:serialize",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "program_plan_test",
    srcs = ["program_plan_test.cc"],
    deps = [
        ":program_plan",
        "//loom/binding/c:loomc",
        "//loom/binding/c/test:test_util",
        "//loom/src/loom/target/arch/cmd:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
