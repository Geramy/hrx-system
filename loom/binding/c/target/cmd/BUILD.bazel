load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_SPIRV_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/arch:spirv",
    "//loom/config/emit:spirv",
])

loom_cc_library(
    name = "cmd",
    srcs = [
        "program.c",
        "program_plan.c",
    ],
    hdrs = [
        "program.h",
        "//loom/binding/c:include/loomc/target/cmd.h",
        "//loom/binding/c:include/loomc/target/cmd/base.h",
        "//loom/binding/c:include/loomc/target/cmd/program.h",
    ],
    linkstatic = True,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/target/arch/cmd:program",
        "//loom/src/loom/target/arch/cmd/lower:launch_artifact",
        "//loom/src/loom/target/arch/cmd/lower:program_plan",
        "//loom/src/loom/target/arch/cmd/lower:serialize",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "program_plan_test",
    srcs = ["program_plan_test.cc"],
    target_compatible_with = _SPIRV_COMPATIBLE_WITH,
    deps = [
        ":cmd",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/test:test_util",
        "//loom/src/loom/target/arch/cmd:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
