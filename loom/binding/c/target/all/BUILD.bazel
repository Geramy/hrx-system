load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_library",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_ALL_TARGET_COPTS = (
    iree_select({
        "//loom/config/target:amdgpu_artifacts": [
            "-DLOOMC_TARGET_ALL_HAVE_AMDGPU=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:iree_vm": [
            "-DLOOMC_TARGET_ALL_HAVE_IREE_VM=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:llvmir_artifacts": [
            "-DLOOMC_TARGET_ALL_HAVE_LLVMIR=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:spirv_artifacts": [
            "-DLOOMC_TARGET_ALL_HAVE_SPIRV=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:wasm": [
            "-DLOOMC_TARGET_ALL_HAVE_WASM=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:x86": [
            "-DLOOMC_TARGET_ALL_HAVE_X86=1",
        ],
        "//conditions:default": [],
    })
)

_ALL_TARGET_DEPS = (
    iree_select({
        "//loom/config/target:amdgpu_artifacts": [
            "//loom/binding/c/target/amdgpu",
            "//loom/src/loom/target/arch/amdgpu:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:iree_vm": [
            "//loom/src/loom/target/arch/ireevm:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:llvmir_artifacts": [
            "//loom/binding/c/target/llvmir",
            "//loom/src/loom/target/arch/llvmir:provider",
            "//loom/src/loom/target/emit/llvmir:artifact_emitter",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:spirv_artifacts": [
            "//loom/binding/c/target/spirv",
            "//loom/src/loom/target/arch/spirv:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:wasm": [
            "//loom/src/loom/target/arch/wasm:provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:x86": [
            "//loom/src/loom/target/arch/x86:provider",
        ],
        "//conditions:default": [],
    })
)

loom_cc_library(
    name = "all",
    srcs = ["all.c"],
    hdrs = ["//loom/binding/c:include/loomc/target/all.h"],
    copts = _ALL_TARGET_COPTS,
    linkstatic = True,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/cmd:provider",
    ] + _ALL_TARGET_DEPS,
    alwayslink = True,
)
