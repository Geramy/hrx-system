low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1025, 1, 1) @prefetch_workgroup_id() asm {
  %workgroup = live_in<amdgpu.cluster_id_x> : reg<amdgpu.sgpr>
  %input_view = resource<hal_binding> {extent = 4100, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %8 = s_lshl_b32_rhs_inline %workgroup, 2
  %9 = s_mov_b32 0
  %22 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %23 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %24 = s_mov_b32 65535
  %25 = s_and_b32 %23, %24
  %26 = concat(%22, %25) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %27 = s_mov_b32 4100
  %28 = s_mov_b32 822173696
  %29 = concat(%26, %27, %28) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %31 = slice %29[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %30 = slice %29[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %17, %18 = s_add_co_u32 %31, %8
  %19, %20 = s_addc_u32 %30, %9, %18
  %21 = concat(%17, %19, %27, %28) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  s_buffer_prefetch_data %21, %9 {count = 0}
  return
}

