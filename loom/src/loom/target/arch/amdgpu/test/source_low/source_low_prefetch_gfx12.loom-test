// The workgroup offset is added to a copy of the descriptor; the static
// prefetch and both loads keep the original resource.
kernel.def @prefetch_workgroup_id_descriptor_copy() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  %workgroups = index.constant 16 : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %workgroup = kernel.workgroup.id<x> : index
  %zero = index.constant 0 : offset
  %input_view = buffer.view %input[%zero] : buffer -> view<1024xi32>
  %output_view = buffer.view %output[%zero] : buffer -> view<64xi32>
  %before = view.load %input_view[%lane] : view<1024xi32> -> i32
  // REMARK@+1: BACKEND/041 "selected prefetch 'read/l2'" "dynamic index 'soffset'" "count 0"
  view.prefetch %input_view[%workgroup] {intent = read, locality = l2} : view<1024xi32>
  %c7 = index.constant 7 : index
  // REMARK@+1: BACKEND/041 "selected prefetch 'read/l2'" "immediate offset 28" "count 0"
  view.prefetch %input_view[%c7] {intent = read, locality = l2} : view<1024xi32>
  %c64 = index.constant 64 : index
  %next = index.add %lane, %c64 : index
  %after = view.load %input_view[%next] : view<1024xi32> -> i32
  %sum = scalar.addi %before, %after : i32
  view.store %sum, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<amdgpu.rdna4.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) workgroup_count(16, 1, 1) @prefetch_workgroup_id_descriptor_copy() asm {
  %workgroup = live_in<amdgpu.cluster_id_x> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 4096, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 256, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %20 = v_lshlrev_b32_src0_inline %lane, 2
  %before = global_load_b32_saddr %20, %input_view
  %22 = s_lshl_b32_rhs_inline %workgroup, 2
  %23 = s_mov_b32 0
  %42 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %43 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %44 = s_mov_b32 65535
  %45 = s_and_b32 %43, %44
  %46 = concat(%42, %45) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %47 = s_mov_b32 4096
  %48 = s_mov_b32 822173696
  %49 = concat(%46, %47, %48) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  %59 = slice %49[0] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %58 = slice %49[1] : reg<amdgpu.sgpr x4> -> reg<amdgpu.sgpr>
  %31, %32 = s_add_co_u32 %59, %22
  %33, %34 = s_addc_u32 %58, %23, %32
  %35 = concat(%31, %33, %47, %48) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  s_buffer_prefetch_data %35, %23 {count = 0}
  %53 = s_and_b32 %43, %44
  %54 = concat(%42, %53) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %57 = concat(%54, %47, %48) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  s_buffer_prefetch_data %57, %23 {offset = 28, count = 0}
  %after = global_load_b32_saddr %20, %input_view {offset = 256}
  %sum = v_add_u32 %before, %after
  global_store_b32_saddr %20, %sum, %output_view
  return
}
