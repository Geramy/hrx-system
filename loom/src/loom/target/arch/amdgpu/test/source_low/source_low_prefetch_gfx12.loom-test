// RUN: emit source-low target=amdgpu:gfx1200 diagnostics=memory output=low

func.def @prefetch_static(%input: buffer) {
  %base = index.constant 16 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  // REMARK@+1: BACKEND/041 "selected prefetch 'read/l1'" "decision 'prefetch.s_buffer_prefetch_data'" "immediate offset 32" "dynamic index 'none'"
  view.prefetch %input_view[4] {intent = read, locality = l1} : view<64xi32>
  func.return
}

// ----
low.func.def target<amdgpu.rdna4.core> abi(hal_kernel) @prefetch_static() asm {
  %input_view = resource<hal_binding> {extent = 272, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %4 = s_mov_b32 0
  %6 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %7 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %8 = s_mov_b32 65535
  %9 = s_and_b32 %7, %8
  %10 = concat(%6, %9) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %11 = s_mov_b32 272
  %12 = s_mov_b32 822173696
  %13 = concat(%10, %11, %12) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x4>
  s_buffer_prefetch_data %13, %4 {offset = 32, count = 0}
  return
}

