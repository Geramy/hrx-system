load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "recording",
    srcs = ["recording.c"],
    hdrs = ["recording.h"],
    visibility = ["//loom/src:__subpackages__"],
    deps = [
        "//loom/src/loom/codegen/low:function",
        "//loom/src/loom/codegen/low:target_binding",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/cmd:program",
        "//loom/src/loom/target/arch/cmd/descriptors",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "recording_test_executable",
    testonly = True,
    srcs = ["recording_test_executable.c"],
    hdrs = ["recording_test_executable.h"],
    visibility = ["//loom/src/loom/target/arch/cmd/lower:__pkg__"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/local:executable_library",
    ],
)

loom_cc_test(
    name = "recording_test",
    srcs = ["recording_test.cc"],
    deps = [
        ":recording",
        ":recording_test_executable",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/codegen/low:verify",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/target/arch/cmd/descriptors:low_registry",
        "//loom/src/loom/target/arch/cmd/lower:serialize",
        "//loom/src/loom/testing:diagnostic_matchers",
        "//loom/src/loom/testing:module_ptr",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/local_sync:sync_driver",
        "//runtime/src/iree/hal/local:executable_library",
        "//runtime/src/iree/hal/local/loaders:static_library_loader",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
