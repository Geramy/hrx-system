load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "schedule",
    srcs = ["schedule.c"],
    hdrs = ["schedule.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/command",
        "//loom/src/loom/ops/kernel",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "lower",
    srcs = ["lower.c"],
    hdrs = ["lower.h"],
    deps = [
        ":schedule",
        "//loom/src/loom/codegen/low:builder",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/command",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/cmd/descriptors",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "serialize",
    srcs = ["serialize.c"],
    hdrs = ["serialize.h"],
    visibility = ["//loom/src:__subpackages__"],
    deps = [
        "//loom/src/loom/codegen/low:function",
        "//loom/src/loom/codegen/low:target_binding",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/cmd:program",
        "//loom/src/loom/target/arch/cmd/descriptors",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "schedule_test",
    srcs = ["schedule_test.cc"],
    deps = [
        ":schedule",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/testing:module_ptr",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "lower_test",
    srcs = ["lower_test.cc"],
    deps = [
        ":lower",
        ":schedule",
        ":serialize",
        "//loom/src/loom/codegen/low:verify",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target/arch/cmd/descriptors:low_registry",
        "//loom/src/loom/target/arch/cmd/iree_hal:recording",
        "//loom/src/loom/testing:diagnostic_matchers",
        "//loom/src/loom/testing:module_ptr",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
