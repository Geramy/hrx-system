// RUN: roundtrip

low.func.def target<cmd.core> abi(command_program) @one_dispatch() asm {
  %parameters = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %output = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %one_u32 = cmd.constant.u32 1
  %zero_u64 = cmd.constant.u64 0
  %length = cmd.constant.u64 4096
  %parameters_ref = cmd.buffer.ref.direct %parameters, %zero_u64, %length
  %output_ref = cmd.buffer.ref.binding %output, %zero_u64, %length
  cmd.dispatch.direct<%executable, %entry>[%one_u32, %one_u32, %one_u32](%parameters_ref, %output_ref)
  return
}

// ----
low.func.def target<cmd.core> abi(command_program) @one_dispatch() {
  %parameters = low.resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %output = low.resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = low.resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = low.resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %one_u32 = low.const<cmd.constant.u32> {value = 1} : reg<cmd.u32>
  %zero_u64 = low.const<cmd.constant.u64> {value = 0} : reg<cmd.u64>
  %length = low.const<cmd.constant.u64> {value = 4096} : reg<cmd.u64>
  %parameters_ref = low.op<cmd.buffer.ref.direct>(%parameters, %zero_u64, %length) : (reg<cmd.buffer>, reg<cmd.u64>, reg<cmd.u64>) -> reg<cmd.buffer_ref>
  %output_ref = low.op<cmd.buffer.ref.binding>(%output, %zero_u64, %length) : (reg<cmd.binding>, reg<cmd.u64>, reg<cmd.u64>) -> reg<cmd.buffer_ref>
  low.op<cmd.dispatch.direct>(%executable, %entry, %one_u32, %one_u32, %one_u32, %parameters_ref, %output_ref) : (reg<cmd.executable>, reg<cmd.entry>, reg<cmd.u32>, reg<cmd.u32>, reg<cmd.u32>, reg<cmd.buffer_ref>, reg<cmd.buffer_ref>)
  low.return
}

// ====

low.func.def target<cmd.core> abi(command_program) @empty_indirect() asm {
  %launch_counts = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %launch_count_offset = cmd.constant.u64 0
  %launch_count_length = cmd.constant.u64 12
  %count_ref = cmd.buffer.ref.binding %launch_counts, %launch_count_offset, %launch_count_length
  cmd.dispatch.indirect.static<%executable, %entry>[%count_ref]()
  return
}

// ----
low.func.def target<cmd.core> abi(command_program) @empty_indirect() {
  %launch_counts = low.resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = low.resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = low.resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %launch_count_offset = low.const<cmd.constant.u64> {value = 0} : reg<cmd.u64>
  %launch_count_length = low.const<cmd.constant.u64> {value = 12} : reg<cmd.u64>
  %count_ref = low.op<cmd.buffer.ref.binding>(%launch_counts, %launch_count_offset, %launch_count_length) : (reg<cmd.binding>, reg<cmd.u64>, reg<cmd.u64>) -> reg<cmd.buffer_ref>
  low.op<cmd.dispatch.indirect.static>(%executable, %entry, %count_ref) : (reg<cmd.executable>, reg<cmd.entry>, reg<cmd.buffer_ref>)
  low.return
}
