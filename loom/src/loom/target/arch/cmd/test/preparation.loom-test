  %6 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %7 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %8 = cmd.constant.u64 0
  %9 = cmd.constant.u64 -1
  %source = cmd.buffer.ref.binding %0, %8, %9
  %scratch = cmd.buffer.ref.binding %1, %8, %9
  %target = cmd.buffer.ref.binding %2, %8, %9
  %13 = cmd.constant.u64 12
  %14 = cmd.buffer.ref.binding %3, %8, %13
  %15 = cmd.arguments.empty
  %16 = cmd.arguments.append.buffer_ref %15, %source
  %17 = cmd.arguments.append.buffer_ref %16, %scratch
  cmd.dispatch.indirect.static %4, %6, %14, %17
  cmd.execution.barrier
  %18 = cmd.arguments.empty
  %19 = cmd.arguments.append.buffer_ref %18, %scratch
  %20 = cmd.arguments.append.buffer_ref %19, %target
