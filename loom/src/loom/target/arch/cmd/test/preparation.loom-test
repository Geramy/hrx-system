// RUN: emit command-program @increment_twice,@increment_then_double

kernel.def @increment(%element_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%element_count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %c1 = scalar.constant 1 : i32
  %source_view = buffer.view %source[%base] : buffer -> view<128xi32, #dense>
  %target_view = buffer.view %target[%base] : buffer -> view<128xi32, #dense>
  %value = view.load %source_view[%workgroup] : view<128xi32, #dense> -> i32
  %result = scalar.addi %value, %c1 : i32
  view.store %result, %target_view[%workgroup] : i32, view<128xi32, #dense>
  kernel.return
}

kernel.def @double(%element_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%element_count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %c2 = scalar.constant 2 : i32
  %source_view = buffer.view %source[%base] : buffer -> view<128xi32, #dense>
  %target_view = buffer.view %target[%base] : buffer -> view<128xi32, #dense>
  %value = view.load %source_view[%workgroup] : view<128xi32, #dense> -> i32
  %result = scalar.muli %value, %c2 : i32
  view.store %result, %target_view[%workgroup] : i32, view<128xi32, #dense>
  kernel.return
}

command.program.def public @increment_then_double(%element_count: index) launch(%source: buffer, %scratch: buffer, %target: buffer) where [range(%element_count, 1, 128)] {
  kernel.launch @increment[%element_count](%source, %scratch) : [index](buffer, buffer)
  kernel.launch @double[%element_count](%scratch, %target) : [index](buffer, buffer)
  command.return
}

command.program.def public @increment_twice(%element_count: index) launch(%source: buffer, %scratch: buffer, %target: buffer) where [range(%element_count, 1, 128)] {
  kernel.launch @increment[%element_count](%source, %scratch) : [index](buffer, buffer)
  kernel.launch @increment[%element_count](%scratch, %target) : [index](buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 4}) @increment_then_double() asm {
  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %2 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %3 = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %4 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %5 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %6 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %7 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %8 = cmd.constant.u64 0
  %9 = cmd.constant.u64 -1
  %source = cmd.buffer.ref.binding %0, %8, %9
  %scratch = cmd.buffer.ref.binding %1, %8, %9
  %target = cmd.buffer.ref.binding %2, %8, %9
  %13 = cmd.constant.u64 12
  %14 = cmd.buffer.ref.binding %3, %8, %13
  cmd.dispatch.indirect.static<%4, %6>[%14](%source, %scratch)
  cmd.barrier.execution
  cmd.dispatch.indirect.static<%5, %7>[%14](%scratch, %target)
  return
}

low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 4}) @increment_twice() asm {
  %15 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
