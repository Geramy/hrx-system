// RUN: emit command-program @copy_twice

kernel.def @copy_one() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %source_view = buffer.view %source[%base] : buffer -> view<1xi32, #dense>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32, #dense>
  %value = view.load %source_view[%c0] : view<1xi32, #dense> -> i32
  view.store %value, %target_view[%c0] : i32, view<1xi32, #dense>
  kernel.return
}

command.program.def @copy_stage() launch(%source: buffer, %target: buffer) {
  kernel.launch @copy_one[](%source, %target) : [](buffer, buffer)
  command.return
}

command.program.def public @copy_twice() launch(%source: buffer, %scratch: buffer, %target: buffer) {
  command.program.launch @copy_stage[](%source, %scratch) : [](buffer, buffer)
  command.program.launch @copy_stage[](%scratch, %target) : [](buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) @copy_twice() asm {
  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %2 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %3 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %4 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %5 = cmd.constant.u64 0
  %6 = cmd.constant.u64 -1
  %source = cmd.buffer.ref.binding %0, %5, %6
  %scratch = cmd.buffer.ref.binding %1, %5, %6
  %target = cmd.buffer.ref.binding %2, %5, %6
  %10 = cmd.arguments.empty
  %11 = cmd.arguments.append.buffer_ref %10, %source
  %12 = cmd.arguments.append.buffer_ref %11, %scratch
  %13 = cmd.constant.u32 1
  cmd.dispatch.direct %3, %4, %13, %13, %13, %12
  cmd.execution.barrier
  %14 = cmd.arguments.empty
  %15 = cmd.arguments.append.buffer_ref %14, %scratch
  %16 = cmd.arguments.append.buffer_ref %15, %target
  cmd.dispatch.direct %3, %4, %13, %13, %13, %16
  return
}

