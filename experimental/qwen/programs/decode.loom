// Complete Qwen3-30B-A3B decode schedule for one 576-row context class.
//
// Model parameters are queried in GGUF source order. The preparation pipeline
// fully unrolls the layer loop and folds the storage predicates before command
// planning, leaving one exact parameter placement and dispatch schedule.

config.def @qwen3_moe.workload.token_capacity = 1 : index
config.def @qwen3_30b.request.token_capacity = 512 : index
config.def @qwen.attention.metadata_context_capacity = 576 : index
config.def @qwen3_moe.model.hidden_size = 2048 : index
config.def @qwen3_moe.model.rms_epsilon = 0.000001 : f32
config.def @qwen3_moe.attention.head_size = 128 : index
config.def @qwen3_moe.attention.query_size = 4096 : index
config.def @qwen3_moe.attention.key_value_size = 512 : index
config.def @qwen3_moe.attention.query_head_count = 32 : index
config.def @qwen3_moe.attention.key_value_head_count = 4 : index
config.def @qwen3_moe.attention.key_value_token_capacity = 576 : index
config.def @qwen3_moe.dense_quantized.input_size = 4096 : index
config.def @qwen3_moe.dense_quantized.output_size = 2048 : index
config.def @qwen3_moe.dense_quantized.output_accumulation = 1 : index
config.def @qwen3_moe.router.expert_count = 128 : index
config.def @qwen3_moe.router.route_count = 8 : index
config.def @qwen3_moe.routed_gate_up.input_size = 2048 : index
config.def @qwen3_moe.routed_gate_up.output_size = 768 : index
config.def @qwen3_moe.routed_gate_up.route_count = 8 : index
config.def @qwen3_moe.routed_gate_up.expert_count = 128 : index
config.def @qwen3_moe.routed_down.input_size = 768 : index
config.def @qwen3_moe.routed_down.output_size = 2048 : index
config.def @qwen3_moe.routed_down.route_count = 8 : index
config.def @qwen3_moe.routed_down.expert_count = 128 : index
config.def @ggml.linear_q6k_q8_1_x4.token_capacity = 1 : index
config.def @ggml.linear_q6k_q8_1_x4.output_capacity = 151936 : index

