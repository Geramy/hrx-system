      %down_weight = command.parameter %parameters, "blk.{}.ffn_down_exps.weight"[%layer] : view<113246208xi8, #dense>
      %gate_weight = command.parameter %parameters, "blk.{}.ffn_gate_exps.weight"[%layer] : view<113246208xi8, #dense>
      %router_weight = command.parameter %parameters, "blk.{}.ffn_gate_inp.weight"[%layer] : view<1048576xi8, #dense>
